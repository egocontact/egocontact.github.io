    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.186.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
